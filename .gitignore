__pycache__/
*.pyc
.claude/
.agents/memory.md

# review scratch (prompts, diffs, sub-agent results)
.agents/

# agy (Antigravity) writes its language-server log to a file literally named `--print`
# in the working directory of a dispatch. It is agy's litter, not summon's output, but it
# lands in whatever repo you point a dispatch at -- so keep it out of commits.
--print

# graphify knowledge graph: regenerated from the source, large, and machine-specific.
# It was ignored only via .git/info/exclude, which is local to one clone -- a fresh
# checkout would not have ignored it.
graphify-out/

# Preserved local AGY acceptance evidence. It can contain prompts and runtime output;
# retain it locally without allowing a broad staging command to publish it.
tmp-agy-smoke/
tmp_agy_smoke.py
